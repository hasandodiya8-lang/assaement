2.23 Advanced APIs

1. Fetch trending movies with a session
import requests

with requests.Session() as session:
    response = session.get(
        "https://api.themoviedb.org/3/trending/movie/day"
    )
    response.raise_for_status()
    print(response.json())
TMDb’s trending endpoint requires authentication, so this request needs an API key or bearer token.
2. Add a TMDb API key
import requests

TMDB_API_KEY = "YOUR_TMDB_API_KEY"

with requests.Session() as session:
    response = session.get(
        "https://api.themoviedb.org/3/trending/movie/day",
        params={"api_key": TMDB_API_KEY}
    )
    response.raise_for_status()
    print(response.json())
Alternatively, TMDb supports a bearer token in the Authorization header:
headers = {"Authorization": "Bearer YOUR_TMDB_READ_ACCESS_TOKEN"}
response = requests.get(
    "https://api.themoviedb.org/3/trending/movie/day",
    headers=headers
)
3. Simulate a login and protected orders request
This uses a local mock server because a real food-delivery service’s login and orders endpoints cannot be assumed to exist or accept dummy credentials.
import requests

BASE_URL = "http://localhost:8000"

with requests.Session() as session:
    login_response = session.post(
        f"{BASE_URL}/login",
        json={"username": "demo_user", "password": "demo_password"}
    )
    login_response.raise_for_status()

    token = login_response.json()["token"]
    session.headers.update({"Authorization": f"Bearer {token}"})

    orders_response = session.get(f"{BASE_URL}/orders")
    orders_response.raise_for_status()
    print(orders_response.json())
4. Fetch the latest five posts asynchronously
Install httpx if needed with pip install httpx.
import asyncio
import httpx

async def fetch_latest_posts():
    async with httpx.AsyncClient() as client:
        response = await client.get(
            "https://jsonplaceholder.typicode.com/posts",
            params={"_start": 0, "_limit": 5}
        )
        response.raise_for_status()

        for post in response.json():
            print(post)

asyncio.run(fetch_latest_posts())
5. OAuth 2.0 example using Spotify
Install requests with pip install requests, register an app in the Spotify Developer Dashboard, and set its redirect URI to http://127.0.0.1:8888/callback.
import secrets
import urllib.parse
import webbrowser
from http.server import BaseHTTPRequestHandler, HTTPServer

import requests

CLIENT_ID = "YOUR_SPOTIFY_CLIENT_ID"
CLIENT_SECRET = "YOUR_SPOTIFY_CLIENT_SECRET"
REDIRECT_URI = "http://127.0.0.1:8888/callback"
SCOPES = "user-read-private"

state = secrets.token_urlsafe(16)

authorize_url = "https://accounts.spotify.com/authorize?" + urllib.parse.urlencode({
    "client_id": CLIENT_ID,
    "response_type": "code",
    "redirect_uri": REDIRECT_URI,
    "scope": SCOPES,
    "state": state,
})

auth_code = None

class CallbackHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        global auth_code
        query = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)

        if query.get("state", [None])[0] != state:
            self.send_response(400)
            self.end_headers()
            self.wfile.write(b"State mismatch.")
            return

        auth_code = query.get("code", [None])[0]
        self.send_response(200)
        self.end_headers()
        self.wfile.write(b"Authorization received. You can close this tab.")

    def log_message(self, *args):
        pass

webbrowser.open(authorize_url)
HTTPServer(("127.0.0.1", 8888), CallbackHandler).handle_request()

token_response = requests.post(
    "https://accounts.spotify.com/api/token",
    data={
        "grant_type": "authorization_code",
        "code": auth_code,
        "redirect_uri": REDIRECT_URI,
    },
    auth=(CLIENT_ID, CLIENT_SECRET),
)
token_response.raise_for_status()
access_token = token_response.json()["access_token"]

profile_response = requests.get(
    "https://api.spotify.com/v1/me",
    headers={"Authorization": f"Bearer {access_token}"},
)
profile_response.raise_for_status()
print(profile_response.json())
2.24 API Mini Projects

## 1. Ahmedabad weather in the console

Replace `YOUR_API_KEY` with your OpenWeatherMap key.

```html
<script>
async function getWeather() {
  const url = "https://api.openweathermap.org/data/2.5/weather?q=Ahmedabad&appid=YOUR_API_KEY&units=metric";
  const response = await fetch(url);

  if (!response.ok) throw new Error(`Weather request failed: ${response.status}`);

  const data = await response.json();
  console.log("Temperature:", data.main.temp, "°C");
  console.log("Condition:", data.weather[0].description);
}

getWeather().catch(console.error);
</script>
```

## 2. Bitcoin and Ethereum prices in INR

Save this as an HTML file and open it in a browser.

```html
<!doctype html>
<html lang="en">
<body>
  <h1>Crypto prices</h1>
  <p id="prices">Loading…</p>

  <script>
    async function loadPrices() {
      const response = await fetch(
        "https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum&vs_currencies=inr"
      );
      if (!response.ok) throw new Error(`Price request failed: ${response.status}`);

      const data = await response.json();
      document.getElementById("prices").innerHTML =
        `Bitcoin: ₹${data.bitcoin.inr.toLocaleString("en-IN")}<br>` +
        `Ethereum: ₹${data.ethereum.inr.toLocaleString("en-IN")}`;
    }

    loadPrices().catch(error => {
      document.getElementById("prices").textContent = error.message;
    });
  </script>
</body>
</html>
```

## 3. NASA Astronomy Picture of the Day

NASA’s API portal now notes that APOD has moved to a new endpoint. This uses the current endpoint, which defaults to today’s picture. [NASA APIs](https://api.nasa.gov/)

```html
<!doctype html>
<html lang="en">
<body>
  <h1 id="title">Loading…</h1>
  <img id="picture" alt="Astronomy Picture of the Day" style="max-width: 100%">
  <p id="description"></p>

  <script>
    async function loadApod() {
      const response = await fetch(
        "https://science.nasa.gov/wp-json/wp/v2/apod-basic/?api_key=DEMO_KEY"
      );
      if (!response.ok) throw new Error(`NASA request failed: ${response.status}`);

      const data = await response.json();
      document.getElementById("title").textContent = data.title;
      document.getElementById("picture").src = data.image_url || data.url;
      document.getElementById("description").textContent = data.explanation || "";
    }

    loadApod().catch(error => {
      document.getElementById("title").textContent = error.message;
    });
  </script>
</body>
</html>
```

## 4. Country COVID-19 case count

This uses disease.sh’s country endpoint. The `cases` value is the cumulative case count. [disease.sh API](https://github.com/disease-sh/API/blob/master/public/apidocs/swagger_v3.json)

```html
<!doctype html>
<html lang="en">
<body>
  <h1>COVID-19 country data</h1>
  <form id="country-form">
    <input id="country" placeholder="Enter a country" required>
    <button type="submit">Search</button>
  </form>
  <p id="result"></p>

  <script>
    document.getElementById("country-form").addEventListener("submit", async event => {
      event.preventDefault();
      const country = document.getElementById("country").value.trim();
      const result = document.getElementById("result");
      result.textContent = "Loading…";

      try {
        const response = await fetch(
          `https://disease.sh/v3/covid-19/countries/${encodeURIComponent(country)}`
        );
        if (!response.ok) throw new Error("Country not found or API request failed.");

        const data = await response.json();
        result.textContent =
          `${data.country}: ${data.cases.toLocaleString()} cumulative cases`;
      } catch (error) {
        result.textContent = error.message;
      }
    });
  </script>
</body>
</html>
```

## 5. City weather and Bitcoin price on one page

Replace `YOUR_API_KEY` with your OpenWeatherMap key. Searching for a city refreshes both results.

```html
<!doctype html>
<html lang="en">
<body>
  <h1>Weather and Bitcoin</h1>
  <form id="search-form">
    <input id="city" value="Ahmedabad" placeholder="Enter a city" required>
    <button type="submit">Search</button>
  </form>
  <p id="weather">Weather will appear here.</p>
  <p id="bitcoin">Bitcoin price will appear here.</p>

  <script>
    const OPENWEATHER_API_KEY = "YOUR_API_KEY";

    async function search() {
      const city = document.getElementById("city").value.trim();
      const weatherEl = document.getElementById("weather");
      const bitcoinEl = document.getElementById("bitcoin");

      weatherEl.textContent = "Loading weather…";
      bitcoinEl.textContent = "Loading Bitcoin price…";

      const weatherUrl =
        `https://api.openweathermap.org/data/2.5/weather?q=${encodeURIComponent(city)}` +
        `&appid=${OPENWEATHER_API_KEY}&units=metric`;
      const bitcoinUrl =
        "https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=inr";

      const [weatherResponse, bitcoinResponse] = await Promise.all([
        fetch(weatherUrl),
        fetch(bitcoinUrl)
      ]);

      if (!weatherResponse.ok) throw new Error(`Weather request failed: ${weatherResponse.status}`);
      if (!bitcoinResponse.ok) throw new Error(`Bitcoin request failed: ${bitcoinResponse.status}`);

      const [weatherData, bitcoinData] = await Promise.all([
        weatherResponse.json(),
        bitcoinResponse.json()
      ]);

      weatherEl.textContent =
        `${weatherData.name}: ${weatherData.main.temp} °C, ${weatherData.weather[0].description}`;
      bitcoinEl.textContent =
        `Bitcoin: ₹${bitcoinData.bitcoin.inr.toLocaleString("en-IN")}`;
    }

    document.getElementById("search-form").addEventListener("submit", async event => {
      event.preventDefault();
      try {
        await search();
      } catch (error) {
        document.getElementById("weather").textContent = error.message;
      }
    });

    search().catch(error => {
      document.getElementById("weather").textContent = error.message;
    });
  </script>
</body>
</html>
```
# 1. Clean the product name
product = " Redmi-Note 12 Pro "
cleaned_product = product.strip().replace("-", " ").title()
print(cleaned_product)

# 2. Split the description into features and print each on a new line
description = "OnePlus Nord CE 3 Lite, 8GB RAM, 128GB Storage"
features = description.split(",")

for feature in features:
    print(feature.strip())

# 3. Return the first word (brand) from a product name
def get_brand(product_name):
    return product_name[:product_name.index(" ")]

print(get_brand("boAt Rockerz 255F Wireless"))

